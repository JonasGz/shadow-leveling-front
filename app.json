{
  "expo": {
    "name": "Shadow Leveling",
    "slug": "shadow-leveling-front",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "shadowleveling",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111113"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jonasgz.shadowleveling",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.jonasgz.shadowleveling",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundImage": "./assets/icons/adaptive-background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#111113"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Shadow Leveling to access Face ID"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.895232327106-ggl4ao0gvti9ddph7t0sbf4m2gt3054o"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bda9751d-bd11-450f-99bb-a12b5dd60c97"
      }
    },
    "owner": "jonasgz"
  }
}
